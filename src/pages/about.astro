---
import Layout from '../components/Layout.astro';
import {href,profile,markdown} from '../lib/blog.mjs';
---
<Layout active="关于我" title="关于我"><section class="paper about"><img class="avatar" src={href(profile.avatar||'art/avatar.webp')} alt="站主头像"/><p class="tag">关于我</p><h1>{profile.nickname}</h1><p>{profile.signature}</p><div class="prose" set:html={markdown(profile.bio)} />{profile.links.map(l=><a class="button" href={l.url} rel="me noopener noreferrer">{l.label}</a>)}</section></Layout>
