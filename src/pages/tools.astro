---
import Layout from '../components/Layout.astro';
---
<Layout active="工具" title="小工具" description="图片排行与动漫九宫格，完成后保存到本地。">
  <header class="tools-head">
    <p class="eyebrow">TOOLS / 小工具</p>
    <h1>把喜欢的作品，排成自己的样子。</h1>
    <p>在下方选一个工具开始。内容只在当前浏览器里编辑，完成后可导出图片。</p>
  </header>

  <nav class="tool-switch" aria-label="选择工具">
    <button type="button" data-tool="tier" aria-pressed="false"><span class="switch-icon">01</span><span><strong>从夯到拉的排行</strong><small>导入图片，拖动或点选分级，导出排行图</small></span><span aria-hidden="true">↗</span></button>
    <button type="button" data-tool="grid" aria-pressed="false"><span class="switch-icon">02</span><span><strong>动漫九宫格</strong><small>检索 Bangumi 番剧，填满九格，导出图片</small></span><span aria-hidden="true">↗</span></button>
  </nav>

  <section id="tier-tool" class="tool-panel" hidden aria-labelledby="tier-heading">
    <div class="panel-heading"><div><p class="eyebrow">01 / 排行</p><h2 id="tier-heading">从夯到拉</h2><p>先导入图片。电脑可拖到对应行，手机可点图片后再点排行行。</p></div><button class="export" type="button" id="tier-export">导出排行图 ↓</button></div>
    <div class="tool-actions"><label class="upload-button">＋ 导入图片<input id="tier-files" type="file" accept="image/*" multiple hidden /></label><button type="button" id="tier-clear">清空排行</button><span id="tier-status" role="status">图片仅保留在当前页面，刷新后会清空。</span></div>
    <div id="tier-board" class="tier-board" aria-label="排行区域">
      {['夯','顶级','人上人','普通','拉'].map((label,index)=><div class="tier-row" data-tier={index}><label><input value={label} maxlength="8" aria-label={`第 ${index+1} 行名称`} /></label><div class="tier-items" data-tier-items={index} aria-label={`${label}行的图片`}><span class="tier-hint">拖放图片，或先点下方图片再点此处</span></div></div>)}
    </div>
    <div class="pool-head"><h3>待分配图片 <span id="tier-count">0</span></h3><p>点一张图片选中，再点上面的排行行；点已排好的图片可重新移动。</p></div>
    <div id="tier-pool" class="tier-pool" aria-label="待分配图片"></div>
  </section>

  <section id="grid-tool" class="tool-panel" hidden aria-labelledby="grid-heading">
    <div id="grid-main">
    <div class="panel-heading"><div><p class="eyebrow">02 / 九宫格</p><h2 id="grid-heading">我的动漫九宫格</h2><p>点一个格子，搜索作品并填入。格子标题也可以自己修改。</p></div><button class="export" type="button" id="grid-export">导出九宫格 ↓</button></div>
    <div class="grid-workspace">
      <div class="anime-grid" id="anime-grid" aria-label="动漫九宫格">
        {['入坑作','最喜欢','冷门宝藏','最佳剧情','最爱角色','最佳画面','意难平','反复重看','私心推荐'].map((label,index)=><div class="anime-cell" data-slot={index}><button type="button" class="cell-select" aria-label={`选择第 ${index+1} 格`}>＋<span>点此选择</span></button><img alt="" hidden /><strong class="cell-title"></strong><input class="cell-label" value={label} maxlength="12" aria-label={`第 ${index+1} 格标题`} /><button type="button" class="cell-remove" aria-label={`清除第 ${index+1} 格`} hidden>×</button></div>)}
      </div>
    </div>
    </div>
    <div id="anime-picker" class="anime-picker" hidden>
      <button id="picker-back" class="picker-back" type="button">← 返回九宫格</button>
      <div class="picker-heading"><p class="eyebrow">BANGUMI / 选择动画</p><h2>查找动画</h2><p id="selected-slot">正在填写九宫格</p></div>
      <div class="grid-search"><label for="anime-query">作品名称</label><div class="search-line"><input id="anime-query" type="search" placeholder="例如：白色相簿" autocomplete="off" /><button id="anime-search" type="button">搜索</button></div><p id="search-status" role="status">搜索结果来自 Bangumi 公开条目。</p><ul id="anime-results" aria-label="动画搜索结果"></ul></div>
    </div>
  </section>
</Layout>
<style is:global>
  .tools-head{margin:30px 0 25px}.eyebrow{color:var(--pink);font-size:11px;font-weight:700;letter-spacing:.16em}.tools-head h1{font:600 clamp(27px,4vw,44px)/1.3 var(--headline);margin:9px 0}.tools-head>p:last-child,.panel-heading p:last-child{color:var(--muted);line-height:1.7;margin:0}
  .tool-switch{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-bottom:22px}.tool-switch button{display:grid;grid-template-columns:50px minmax(0,1fr) 18px;align-items:center;gap:15px;text-align:left;padding:20px;border:1px solid #e6e0e9;border-radius:20px;background:#fff;box-shadow:0 12px 25px -23px #1d1728}.tool-switch button[aria-pressed=true]{border-color:#ad809c;background:#faf6fa;box-shadow:0 14px 30px -23px #6a3b5a}.switch-icon{display:grid;place-items:center;width:50px;height:50px;border-radius:14px;background:#f1eaf2;color:var(--pink);font:700 18px var(--headline)}.tool-switch strong,.tool-switch small{display:block}.tool-switch strong{font-size:17px}.tool-switch small{margin-top:5px;color:var(--muted);font-size:11px;line-height:1.4}
  .tool-panel{background:#fff;border:1px solid #e3dfe7;border-radius:24px;padding:clamp(15px,3vw,29px);margin-bottom:45px;box-shadow:0 16px 38px -33px #211929}.panel-heading{display:flex;justify-content:space-between;gap:20px;align-items:center;border-bottom:1px solid var(--rule);padding-bottom:18px}.panel-heading h2{margin:3px 0 7px;font:600 29px var(--headline)}.panel-heading .eyebrow{margin:0}.export,.upload-button{border:0;border-radius:11px;padding:11px 17px;color:#fff;background:#5a425a;font-weight:600;white-space:nowrap;cursor:pointer}.export:hover,.upload-button:hover{background:#704b65}.tool-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:18px 0}.tool-actions>button{padding:9px 14px;border:1px solid var(--rule);border-radius:10px;background:#fff}.tool-actions span{font-size:11px;color:var(--muted)}
  .tier-board{border:1px solid #e6e0e7;border-radius:14px;overflow:hidden}.tier-row{display:grid;grid-template-columns:115px minmax(0,1fr);min-height:108px;border-bottom:1px solid #e6e0e7}.tier-row:last-child{border-bottom:0}.tier-row>label{display:flex;flex-direction:column;justify-content:center;gap:6px;padding:12px;background:#e7a7b9}.tier-row:nth-child(2)>label{background:#efc099}.tier-row:nth-child(3)>label{background:#f2dca6}.tier-row:nth-child(4)>label{background:#c6d4c9}.tier-row:nth-child(5)>label{background:#bfc6d8}.tier-row>label span{font-size:10px;opacity:.7}.tier-row>label input{width:100%;border:0;border-bottom:1px solid #51475a66;background:transparent;font-size:17px;font-weight:700;outline-offset:0}.tier-items,.tier-pool{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:10px;min-height:106px}.tier-items.drag-over,.tier-pool.drag-over{background:#f4ebf2}.tier-hint{font-size:11px;color:#a29aa5}.tier-items:has(.tier-card) .tier-hint{display:none}.pool-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-top:20px}.pool-head h3{font-size:16px}.pool-head p{color:var(--muted);font-size:11px}.tier-pool{border:1px dashed #d7cfda;border-radius:14px}.tier-card{position:relative;display:grid;align-content:start;width:76px;border:2px solid transparent;border-radius:8px;background:#f8f6f9;padding:2px;text-align:left}.tier-card.selected{border-color:var(--pink);box-shadow:0 0 0 2px #b88aa344}.tier-card img{width:68px;height:68px;object-fit:cover;border-radius:5px}.tier-card span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;padding:3px 1px}.tier-card .remove-card{position:absolute;right:1px;top:1px;border:0;border-radius:50%;background:#fff;color:#5a425a;width:20px;height:20px;line-height:1}
  .grid-workspace{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:25px;margin-top:23px}.anime-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.anime-cell{position:relative;aspect-ratio:1/1.12;border:1px solid #e2dce5;border-radius:12px;overflow:hidden;background:linear-gradient(145deg,#f7f3f8,#eceaf2);text-align:center}.anime-cell.active{outline:2px solid var(--pink);outline-offset:2px}.anime-cell>img{display:block;width:100%;height:100%;object-fit:cover}.cell-select{position:absolute;inset:0;width:100%;border:0;background:transparent;color:#a18aa0;font-size:32px}.cell-select span{display:block;font-size:11px}.anime-cell:has(img:not([hidden])) .cell-select{color:transparent}.anime-cell:has(img:not([hidden])) .cell-select span{display:none}.anime-cell .cell-title{position:absolute;bottom:32px;left:0;right:0;padding:22px 6px 5px;background:linear-gradient(transparent,#1b1720d9);color:#fff;font-size:11px;line-height:1.3;max-height:62px;overflow:hidden}.anime-cell:has(img[hidden]) .cell-title{display:none}.cell-label{position:absolute;bottom:0;left:0;width:100%;height:32px;border:0;border-top:1px solid #e6e1e8;background:#fff;text-align:center;font-weight:700;font-size:12px}.cell-remove{position:absolute;top:4px;right:4px;border:0;border-radius:50%;background:#fff;width:22px;height:22px}.grid-search{border:1px solid #ebe7ed;border-radius:16px;padding:17px;align-self:start;background:#fdfbfd}.grid-search h3{margin:0 0 6px}.grid-search p{font-size:11px;color:var(--muted);line-height:1.5}.grid-search label{display:block;margin:17px 0 8px;font-weight:600}.search-line{display:flex;gap:6px}.search-line input{min-width:0;width:100%;border:1px solid var(--rule);border-radius:9px;padding:9px}.search-line button{flex:none;white-space:nowrap;border:0;border-radius:9px;background:#5a425a;color:#fff;padding:9px 12px}.grid-search ul{list-style:none;padding:0;margin:10px 0 0;max-height:500px;overflow:auto}.grid-search li button{width:100%;display:flex;align-items:center;gap:10px;text-align:left;border:0;border-bottom:1px solid var(--rule);background:transparent;padding:9px 2px}.grid-search li button:hover{background:#f4edf3}.grid-search li img{width:40px;height:53px;object-fit:cover;border-radius:4px}.grid-search li strong{font-size:12px}.grid-search li small{display:block;color:var(--muted);font-size:10px;margin-top:3px}
  @media(max-width:800px){.grid-workspace{grid-template-columns:1fr}.grid-search ul{max-height:350px}}@media(max-width:620px){.tool-switch{grid-template-columns:1fr}.panel-heading{align-items:flex-start;flex-direction:column}.tier-row{grid-template-columns:78px minmax(0,1fr)}.tier-row>label{padding:7px}.tier-row>label input{font-size:13px}.tier-items{gap:4px;padding:5px}.tier-card{width:65px}.tier-card img{width:57px;height:57px}.anime-grid{gap:5px}.anime-cell{border-radius:7px}.cell-label{font-size:10px}.anime-cell .cell-title{font-size:9px}}
  .grid-workspace{display:block}.anime-grid{max-width:790px;margin:24px auto 0}.anime-picker{max-width:790px;margin:0 auto;min-height:560px}.picker-back{border:0;background:transparent;color:var(--pink);padding:8px 0;font-weight:650}.picker-heading{padding:14px 0 19px;border-bottom:1px solid var(--rule)}.picker-heading h2{margin:5px 0;font:600 29px var(--headline)}.picker-heading p:last-child{color:var(--muted);margin:0}.anime-picker .grid-search{margin-top:20px;padding:20px}.anime-picker .grid-search label{margin:0 0 8px}.anime-picker .grid-search ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px 20px;max-height:none}.anime-picker .grid-search li img{flex:none;width:50px;height:68px}.anime-picker .grid-search li strong{font-size:13px}.anime-picker .grid-search li small{font-size:11px}
  @media(max-width:620px){.anime-picker .grid-search ul{grid-template-columns:1fr}.anime-picker .grid-search{padding:14px}.anime-picker{min-height:500px}}
</style>
<script>import '../scripts/tools.js';</script>
