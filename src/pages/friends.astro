---
import Layout from '../components/Layout.astro';
import {profile} from '../lib/blog.mjs';
const friends=profile.friends||[];
---
<Layout title="同好友链" active="">
  <header class="page-head"><h1>同好友链</h1></header>
  {friends.length ? <ul class="journal-list">{friends.map(friend=><li><div><a href={friend.url} rel="friend noopener noreferrer">{friend.label} ↗</a>{friend.note&&<p>{friend.note}</p>}</div></li>)}</ul> : <p class="empty">站主还没有添加友链。</p>}
</Layout>
