---
import BrowseLayout from '../../components/BrowseLayout.astro';
import Layout from '../../components/Layout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import {albums} from '../../lib/blog.mjs';
const categories=[...new Set(albums.map(album=>album.category || '未分类'))];
const visualAlbum=albums.find(album=>album.id==='field-sketches');
const orderedAlbums=visualAlbum?[visualAlbum,...albums.filter(album=>album!==visualAlbum)]:albums;
---
<Layout active="相册" title="照片相册">
  <BrowseLayout title="照片相册" note={`共 ${albums.length} 本相册`}>
  <div slot="filters" class="filters album-filters" aria-label="相册分类">{['',...categories].map(category=><button data-filter={category} aria-pressed={!category?'true':'false'}>{category||'全部相册'}</button>)}</div>
  <div class="album-grid">{orderedAlbums.map((album,index)=><AlbumCard album={album} featured={index===0}/>)}{!albums.length&&<p>暂时没有公开的相册。</p>}</div>
  </BrowseLayout>
  <script>
    const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    for(const filter of filters)filter.onclick=()=>{
      for(const button of filters)button.setAttribute('aria-pressed',String(button===filter));
      const cards=[...document.querySelectorAll<HTMLElement>('[data-category]')];
      for(const card of cards){card.hidden=!!filter.dataset.filter&&card.dataset.category!==filter.dataset.filter;card.classList.remove('album-featured');}
      cards.find(card=>!card.hidden&&card.dataset.featured==='true')?.classList.add('album-featured');
    };
  </script>
</Layout>
