---
import Layout from '../../components/Layout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import {albums} from '../../lib/blog.mjs';
---
<Layout active="相册" title="照片相册"><div class="page-head"><h1>照片相册</h1><p>共 {albums.length} 本相册</p></div><div class="album-grid">{albums.map(album=><AlbumCard album={album}/>)}{!albums.length&&<p>暂时没有公开的相册。</p>}</div></Layout>
