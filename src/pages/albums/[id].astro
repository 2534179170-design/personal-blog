---
import Layout from '../../components/Layout.astro';
import Share from '../../components/Share.astro';
import WorkLinks from '../../components/WorkLinks.astro';
import {albums,href} from '../../lib/blog.mjs';
export function getStaticPaths() {
  return albums.map(album => ({ params: { id: album.id }, props: { album } }));
}
const {album}=Astro.props;
---
<Layout active="相册" title={album.title}>
  <header class:list={['page-head',{'winter-album-head':album.id==='field-sketches'}]}><a class="back" href={href('albums/')}>← 全部相册</a><h1>{album.title}</h1><p>{album.category && <span class="tag">{album.category}</span>} {album.description}</p><WorkLinks works={album.works}/><Share/>{album.id==='field-sketches' && <div class="winter-head-art" aria-hidden="true"><img class="winter-head-quote" src={href('art/wa2-provided-mark.png')} width="46" height="213" alt=""/><img class="winter-head-logo" src={href('art/wa2-provided-logo.png')} width="511" height="320" alt=""/></div>}</header>
  <div class="photo-grid gallery-wall">{album.photos.map((p,i)=>
    <button type="button" data-photo data-src={href(p.src)} data-caption={p.caption} data-warning={p.spoiler||''}>
      {p.spoiler ? <><strong>含剧透 · 点击查看</strong><span>{p.spoiler}</span></> : <><img loading="lazy" src={href(p.thumb)} alt={p.caption||'相片 '+(i+1)}/><span>{p.caption}</span></>}
    </button>)}
  </div>
  <dialog id="viewer"><div class="split"><span id="photo-counter"></span><button id="exit" aria-label="关闭大图">×</button></div>
    <img id="full" alt=""/><button id="reveal-photo" class="button" hidden></button>
    <div class="split"><button id="prev" aria-label="上一张">←</button><span id="caption"></span><button id="next" aria-label="下一张">→</button></div>
  </dialog>
</Layout>
<script>
  const pics=[...document.querySelectorAll<HTMLButtonElement>('[data-photo]')];
  const dlg=document.querySelector('#viewer') as HTMLDialogElement;
  const full=dlg.querySelector('#full') as HTMLImageElement;
  const reveal=dlg.querySelector('#reveal-photo') as HTMLButtonElement;
  let index=0;
  let change=0;
  function show(i:number, consent=false){
    const revision=++change;
    const direction=Math.sign(i-index);
    index=(i+pics.length)%pics.length;
    const {src,caption,warning}=pics[index].dataset;
    const hidden=Boolean(warning)&&!consent;
    full.hidden=hidden; reveal.hidden=!hidden;
    full.getAnimations().forEach(animation=>animation.cancel());
    if(hidden)full.removeAttribute('src');
    else {
      full.src=src!;
      full.decode().then(()=>{
        if(revision===change && dlg.open && matchMedia('(prefers-reduced-motion: no-preference)').matches){
          full.animate([{opacity:.35,transform:'translateX('+direction*12+'px) scale(.994)'},{opacity:1,transform:'none'}],{duration:260,easing:'ease-out'});
        }
      }).catch(()=>{});
    }
    full.alt=hidden?'':caption||'相片';
    reveal.textContent=warning+' · 展开剧透照片';
    dlg.querySelector('#caption')!.textContent=hidden?'':caption||'';
    dlg.querySelector('#photo-counter')!.textContent=(index+1)+' / '+pics.length;
  }
  pics.forEach((b,i)=>b.onclick=()=>{show(i,true);dlg.showModal()});
  reveal.onclick=()=>show(index,true);
  dlg.querySelector('#exit')!.addEventListener('click',()=>dlg.close());
  dlg.querySelector('#next')!.addEventListener('click',()=>show(index+1));
  dlg.querySelector('#prev')!.addEventListener('click',()=>show(index-1));
  dlg.addEventListener('keydown',e=>{if(e.key==='ArrowRight')show(index+1);if(e.key==='ArrowLeft')show(index-1)});
  let x=0;
  dlg.addEventListener('touchstart',e=>x=e.changedTouches[0].clientX);
  dlg.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-x;if(Math.abs(dx)>45)show(index+(dx<0?1:-1))});
</script>
