---
import Layout from '../components/Layout.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import AlbumCard from '../components/AlbumCard.astro';
import {href,profile,posts,albums} from '../lib/blog.mjs';
---
<Layout><section class="hero" aria-labelledby="site-title"><img class="hero-art" src={href(profile.cover||'art/meadow.webp')} fetchpriority="high" alt="绿荫下的小路穿过草坡，通向红瓦小屋"/><div class="hero-shade"></div><div class="hero-copy"><div class="hero-kicker"><span></span> 乡野生活手记</div><h1 id="site-title">{profile.siteName}</h1><p>{profile.signature}</p><a class="hero-btn" href={href('posts/')}>翻开手记 <Icon name="arrow" size={16}/></a></div></section>
<div class="home-grid"><section><div class="section-head"><h2><i><Icon name="quill" size={23}/></i>最新手记</h2><a href={href('posts/')}>全部文章 <Icon name="arrow" size={15}/></a></div><div class="post-list">{posts.slice(0,5).map(post=><PostRow post={post}/>)}{!posts.length&&<p class="empty">第一篇手记正在酝酿中。</p>}</div></section>
<aside><div class="section-head"><h2><i><Icon name="leaf" size={22}/></i>站主名片</h2></div><div class="profile-card"><div class="postmark" aria-hidden="true"><Icon name="sun" size={23}/></div><img class="avatar" src={href(profile.avatar||'art/avatar.webp')} alt="站主头像"/><h3>{profile.nickname}</h3><p>{profile.signature}</p><div class="stats"><a href={href('posts/')}><b>{posts.length}</b> 篇手记</a><span>·</span><a href={href('albums/')}><b>{albums.length}</b> 本相册</a></div><a class="profile-link" href={href('about/')}>关于我 <Icon name="arrow" size={14}/></a></div>
<div class="section-head album-head"><h2><i><Icon name="camera" size={21}/></i>最近相册</h2><a href={href('albums/')}>更多 <Icon name="arrow" size={14}/></a></div><div class="mini-albums">{albums.slice(0,2).map(album=><AlbumCard album={album}/>)}{!albums.length&&<p>相册准备中。</p>}</div></aside></div></Layout>
