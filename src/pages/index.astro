---
import Layout from '../components/Layout.astro';
import Watching from '../components/Watching.astro';
import Activity from '../components/Activity.astro';
import CollectionStats from '../components/CollectionStats.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { href, profile, posts, albums, markdown } from '../lib/blog.mjs';
const tags = [...new Set(posts.flatMap(post => post.tags))];
const featuredPosts = [...posts.filter(post => post.tags.includes('番组计划短评')), ...posts.filter(post => !post.tags.includes('番组计划短评'))];
const winterPhotos = albums.find(album => album.id === 'field-sketches')?.photos.filter(photo => !photo.spoiler) || [];
const slides = winterPhotos.length ? winterPhotos.map(photo => photo.src) : [profile.cover || 'art/winter-piano.webp'];
---
<Layout>
  <section class="welcome">
    <div class="welcome-art">{slides.map((src, index) => <img class="welcome-slide" src={href(src)} alt="" aria-hidden="true" data-active={index === 0} fetchpriority={index === 0 ? 'high' : 'auto'} loading={index === 0 ? 'eager' : 'lazy'}/>)}</div>
    <div class="welcome-copy">
      
      <h1>{profile.siteName}</h1>
      <div class="hero-bio" set:html={markdown(profile.bio)} />
      {profile.signature && <p>{profile.signature}</p>}
      {profile.now && <p class="now"><strong>近况</strong> {profile.now}</p>}
      <div class="hero-actions"><a class="welcome-link" href="#watching">正在追的动画 <Icon name="arrow" size={15}/></a><a href={href('posts/')}>浏览空间</a></div>
    </div>
    <a class="hero-caption" href={href('albums/field-sketches/')}>白色相簿 · 图集 ↗</a>
  </section>
  <div class="home-edition">
  <nav class="home-contents" aria-label="首页章节">
    <a href="#watching">追番记录</a><a href="#updates">统计与动态</a><a href="#recent-space">最近空间</a>
  </nav>
  <div class="home-sections">
  <div id="watching"><Watching/></div>
  <div id="updates" class="home-panels">
    <CollectionStats compact/>
    <Activity compact/>
  </div>
  <div class="home-grid">
    <div class="main-column">
      <section id="recent-space" class="home-space">
        <div class="section-head">
          <h2>空间<span>最近更新</span></h2>
          <a href={href('posts/')}>全部空间 <Icon name="arrow" size={13} /></a>
        </div>
        <div class="post-list">{featuredPosts.slice(0, 5).map(post => <PostRow post={post} showAvatar={false} />)}</div>
        {!posts.length && <p class="empty">还没有公开的空间内容。</p>}
      </section>
    </div>
    <aside class="sidebar">
      <section class="profile-card">
        <div class="profile-heading"><span>这里的主人</span><Icon name="user" size={15} /></div>
        <div class="profile-identity">
          <a href={href('about/')}><img class="avatar" src={href(profile.avatar || 'art/avatar-mingxue.webp')} alt="站主头像" /></a>
          <div><h2><a href={href('about/')}>{profile.nickname}</a></h2><span class="owner-label">站主</span></div>
        </div>
        <div class="profile-social" aria-label="站主的其他主页">
          {profile.links.map(link => <a href={link.url} target="_blank" rel="me noopener noreferrer">{link.label} ↗</a>)}
        </div>

        <div class="stats">
          <a href={href('posts/')}><b>{posts.length}</b><span>空间</span></a>
          <a href={href('albums/')}><b>{albums.length}</b><span>相册</span></a>
          <a href={href('albums/')}><b>{albums.reduce((total, album) => total + album.photos.length, 0)}</b><span>照片</span></a>
        </div>
        <a class="profile-link" href={href('about/')}>查看完整资料 <Icon name="arrow" size={13} /></a>
      </section>
      <section class="side-section">
        <h2>空间分类</h2>
        <div class="tag-cloud">{tags.map(tag => <a href={href('posts/') + '?tag=' + encodeURIComponent(tag)}>{tag}<small>{posts.filter(post => post.tags.includes(tag)).length}</small></a>)}</div>
        {!tags.length && <p class="muted">还没有分类。</p>}
      </section>
    </aside>
  </div>
  </div></div>
</Layout>
<script>
  const hero = document.querySelector('.welcome');
  const slides = [...document.querySelectorAll<HTMLElement>('.welcome-slide')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;
  function show(next: number) {
    if (slides.length < 2) return;
    slides[current].dataset.active = 'false';
    current = (next + slides.length) % slides.length;
    slides[current].dataset.active = 'true';
  }
  function schedule() {
    clearInterval(timer);
    if (!reduced.matches && !document.hidden && !hero?.matches(':hover, :focus-within') && slides.length > 1) timer = setInterval(() => show(current + 1), 9000);
  }
  hero?.addEventListener('mouseenter', () => clearInterval(timer));
  hero?.addEventListener('mouseleave', schedule);
  hero?.addEventListener('focusin', () => clearInterval(timer));
  hero?.addEventListener('focusout', schedule);
  document.addEventListener('visibilitychange', schedule);
  reduced.addEventListener('change', schedule);
  schedule();
</script>
