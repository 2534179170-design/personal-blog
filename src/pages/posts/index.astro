---
import Layout from '../../components/Layout.astro';
import PostRow from '../../components/PostRow.astro';
import { posts } from '../../lib/blog.mjs';
const tags = [...new Set(posts.flatMap(post => post.tags))];
---
<Layout active="空间" title="空间">
  <div class="page-head"><h1>空间</h1><p>共 {posts.length} 篇记录</p></div>
  <div class="filters" aria-label="按标签筛选">
    {['全部', ...tags].map((tag, index) => <button aria-pressed={index === 0} data-filter={index ? tag : ''}>{tag}</button>)}
  </div>
  <div class="post-list archive">{posts.map(post => <PostRow post={post} />)}</div>
  {!posts.length && <p class="empty">暂时没有公开的空间内容。</p>}
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    function filter(tag: string) {
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === tag)));
      document.querySelectorAll<HTMLElement>('[data-tags]').forEach(element => {
        element.hidden = Boolean(tag) && !JSON.parse(element.dataset.tags || '[]').includes(tag);
      });
    }
    buttons.forEach(button => button.addEventListener('click', () => {
      const tag = button.dataset.filter || '';
      filter(tag);
      const url = new URL(location.href);
      if (tag) url.searchParams.set('tag', tag);
      else url.searchParams.delete('tag');
      history.replaceState(null, '', url);
    }));
    const initial = new URLSearchParams(location.search).get('tag') || '';
    filter(buttons.some(button => button.dataset.filter === initial) ? initial : '');
  </script>
</Layout>
