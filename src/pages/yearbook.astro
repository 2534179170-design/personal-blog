---
import Layout from '../components/Layout.astro';
import {profile,posts,albums,href} from '../lib/blog.mjs';
const favorites=profile.favorites||[];
const entries=[...posts.map(p=>({...p,kind:'空间',path:href('posts/'+p.id+'/')})),...albums.map(a=>({...a,kind:'相册',path:href('albums/'+a.id+'/')}))].sort((a,b)=>b.date.localeCompare(a.date));
const current=new Intl.DateTimeFormat('en',{timeZone:'Asia/Shanghai',year:'numeric'}).format(new Date());
const years=[...new Set([current,...entries.map(e=>e.date.slice(0,4)),...favorites.map(f=>f.year)])].sort().reverse();
---
<Layout active="" title="年度回顾">
  <header class="page-head"><h1>年度回顾</h1><label>查看年份 <select id="year">{years.map(y=><option selected={y===current}>{y}</option>)}</select></label></header>
  <div class="year-grid">
    <section><h2>空间与相册</h2><ul class="journal-list" id="year-entries">{entries.map(e=><li data-year={e.date.slice(0,4)} hidden={e.date.slice(0,4)!==current}><time>{e.date}</time><span class="tag">{e.kind}</span><a href={e.path}>{e.title}</a></li>)}</ul><p id="entry-count" class="muted"></p></section>
    <section><h2>年度最爱</h2>{favorites.map(f=><div data-year={f.year} hidden={f.year!==current}><strong>{f.title}</strong><p>{f.note}</p></div>)}<p class="muted" id="no-favorite">这一年的最爱尚未填写。</p></section>
  </div>
  <section><h2>看过与玩过</h2><p class="muted">按番组计划公开收藏的最后更新时间归年。后续修改评分或短评，作品可能移到修改当年。</p>
    <button class="button" id="read-year">读取番组计划记录</button><p role="status" id="year-status"></p><div class="year-grid" id="year-works"></div>
  </section>
</Layout>
<script>
  import '../scripts/yearbook.js';
</script>
