---
import Layout from '../components/Layout.astro';
import {href,base,adminUrl} from '../lib/blog.mjs';
import '../styles/admin.css';
---
<Layout title="站主管理" active=""><section class="admin paper" id="editor-app" data-base={base} data-primary={base&&adminUrl!==href('admin/')?adminUrl:''}>
<h1>站主管理</h1><p id="account-info" role="status">正在读取站点配置…</p><div class="actions"><a class="button" id="login" hidden href={href('api/login')}>用 GitHub 站主账号登录</a><button id="logout" hidden>退出登录</button></div>
<div id="workspace" hidden><div class="editor-nav"><button data-open="posts">空间</button><button data-open="albums">相册</button><button data-open="profile">个人资料</button></div><div id="library"></div><form id="editor" hidden><h2 id="form-title"></h2><p class="hint">草稿自动保存在这台设备的当前浏览器。清除浏览数据会删除草稿。</p><div id="fields"></div><div class="actions"><button type="button" id="preview">预览</button><button type="submit" class="publish" id="publish">发布</button><button type="button" id="withdraw" hidden>撤下内容</button><button type="button" id="discard">丢弃草稿</button></div></form><p id="publish-status" role="status" aria-live="polite"></p><div id="published-link"></div></div></section>
<dialog id="preview-dialog"><div class="split"><h2>发布预览</h2><button id="close-preview" aria-label="关闭预览">×</button></div><div id="preview-content" class="prose"></div></dialog><script>import '../scripts/admin.js';</script></Layout>
