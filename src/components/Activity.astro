---
import Icon from './Icon.astro';
import snapshot from '../../public/data/bangumi-activity.json';
import {TIMELINE_URL} from '../lib/bangumi-activity.mjs';

const formatTime = value => new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric',
  hour: '2-digit', minute: '2-digit',
}).format(new Date(value));
---
<section class="activity" id="bangumi-activity" data-live={import.meta.env.BASE_URL === '/'} aria-labelledby="activity-heading">
  <div class="section-head">
    <h2 id="activity-heading">动态 <span>来自 Bangumi 的时间胶囊</span></h2>
    <a href={TIMELINE_URL} target="_blank" rel="noopener noreferrer">查看全部动态 <Icon name="arrow" size={13}/></a>
  </div>
  <ul class="activity-list" id="activity-list" aria-label="最近的番组计划动态">
    {snapshot.events.map(event => <li>
      <a class="activity-card" href={event.url} target="_blank" rel="noopener noreferrer">
        <span class="activity-cover">
          {event.cover && <img src={event.cover} alt="" loading="lazy" referrerpolicy="no-referrer" />}
        </span>
        <span class="activity-copy">
          <span class="activity-top"><span class="activity-action">{event.action}</span><time datetime={event.createdAt}>{formatTime(event.createdAt)}</time></span>
          <strong>{event.title}</strong>
          {event.detail && <small>{event.detail}</small>}
        </span>
      </a>
    </li>)}
  </ul>
  <p class="activity-status" id="activity-status" role="status">最新公开动态：{formatTime(snapshot.events[0]?.createdAt || snapshot.updatedAt)} · 最近同步：{formatTime(snapshot.updatedAt)}</p>
</section>
<script>
  const root = document.querySelector('#bangumi-activity');
  const list = document.querySelector('#activity-list');
  const status = document.querySelector('#activity-status');
  const formatter = new Intl.DateTimeFormat('zh-CN', {timeZone:'Asia/Shanghai',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'});
  let pending = false;
  function card(event) {
    const li = document.createElement('li');
    const link = document.createElement('a');
    link.className = 'activity-card';
    link.href = event.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    const cover = document.createElement('span');
    cover.className = 'activity-cover';
    if (event.cover?.startsWith('https://lain.bgm.tv/')) {
      const image = document.createElement('img');
      image.src = event.cover;
      image.alt = '';
      image.loading = 'lazy';
      image.referrerPolicy = 'no-referrer';
      image.onerror = () => image.remove();
      cover.append(image);
    }
    const copy = document.createElement('span');
    copy.className = 'activity-copy';
    const top = document.createElement('span');
    top.className = 'activity-top';
    const action = document.createElement('span');
    action.className = 'activity-action';
    action.textContent = event.action;
    const time = document.createElement('time');
    time.dateTime = event.createdAt;
    time.textContent = formatter.format(new Date(event.createdAt));
    top.append(action, time);
    const title = document.createElement('strong');
    title.textContent = event.title;
    copy.append(top, title);
    if (event.detail) {
      const detail = document.createElement('small');
      detail.textContent = event.detail;
      copy.append(detail);
    }
    link.append(cover, copy);
    li.append(link);
    return li;
  }
  async function refresh() {
    if (root?.dataset.live !== 'true' || pending || document.hidden) return;
    pending = true;
    try {
      const response = await fetch('/api/activity', {cache:'no-store',signal:AbortSignal.timeout(12000)});
      if (!response.ok) throw new Error('动态暂时不可用');
      const data = await response.json();
      if (!Array.isArray(data.events) || !data.events.length) throw new Error('没有公开动态');
      list?.replaceChildren(...data.events.map(card));
      if (status) status.textContent = `最新公开动态：${formatter.format(new Date(data.events[0].createdAt))} · 最近同步：${formatter.format(new Date(data.updatedAt))}`;
    } catch {
      if (status) status.textContent = '暂时无法刷新，正在显示最近一次同步的动态。';
    } finally { pending = false; }
  }
  refresh();
  document.addEventListener('visibilitychange', refresh);
  setInterval(refresh, 60000);
</script>
