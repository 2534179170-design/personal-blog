---
import stats from '../../public/data/bangumi-stats.json';
import {href,workIndex} from '../lib/blog.mjs';
const statusItems=[['','全部','total'],['1','想看','want'],['3','在看','doing'],['2','看过','completed'],['4','搁置','onHold'],['5','抛弃','dropped']];
---
<section id="collection" class="collection-panel"><div class="section-head"><h2>我的收藏 <span>按最近更新排序</span></h2><a class="collection-source" href="https://chii.in/user/828732" target="_blank" rel="noopener noreferrer">Bangumi 主页 ↗</a></div>
  <div class="collection-browser">
  <div class="collection-filters">
  <div class="controls">
    <div class="filters" aria-label="作品类型" role="group">
      <button data-kind="2" aria-pressed="true">动画</button>
      <button data-kind="4" aria-pressed="false">游戏</button>
    </div>
  </div>
  <div class="status-grid" id="status-grid" data-groups={JSON.stringify(stats.groups)} role="group" aria-label="按收藏状态筛选">
    {statusItems.map(([value,label,key])=><button type="button" data-status={value} data-count-key={key} aria-pressed={value==='3'}><strong>{(key==='total'?stats.groups.anime.total:stats.groups.anime.states[key]).toLocaleString('zh-CN')}</strong><span>{label}</span></button>)}
  </div>
  </div>
  <div class="collection-results">
  <noscript>请启用浏览器脚本，或通过上方账号链接查看收藏。</noscript>
  <p id="sync-status" class="muted" role="status"></p>
  <ul id="collection-list" data-works={JSON.stringify(Object.fromEntries([...workIndex.keys()].map(id=>[id,href('works/'+id+'/')])))} aria-label="作品列表"></ul>
  <div class="pager"><button id="previous" disabled>上一页</button><button id="next" disabled>下一页</button><button id="refresh">刷新记录</button></div>
  </div></div>
  </section>
<style>
  .collection-panel { border:1px solid var(--rule); border-radius:22px; padding:clamp(17px,3vw,30px); background:#fff; margin:18px 0 42px; scroll-margin-top:105px; }
  .collection-source { color:var(--muted); font-size:12px; }
  .controls, .pager {display:flex; align-items:center; gap:16px; flex-wrap:wrap}
  .controls { margin-top:15px; }
  .controls .filters {margin:0}
  .controls label, .pager {font-size:13px;color:#666}
  .pager button {border:1px solid var(--rule);border-radius:8px;background:white;padding:8px 13px}
  .status-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:9px; margin:16px 0; }
  .status-grid button { min-width:0; padding:12px; text-align:left; border:1px solid #e8e4ec; border-radius:14px; background:#faf9fc; }
  .status-grid button[aria-pressed=true] { border-color:#cdaebf; background:#fbf2f7; box-shadow:0 8px 20px -17px #643951; }
  .status-grid strong { display:block; font-size:clamp(19px,2.5vw,29px); font-variant-numeric:tabular-nums; color:var(--ink); }
  .status-grid span { color:var(--muted); font-size:12px; }
  #collection-list {list-style:none;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:0}
  #collection-list :global(li) { display:grid; grid-template-columns:72px minmax(0,1fr) auto; align-items:center; gap:18px; min-width:0; border-bottom:1px solid var(--rule); padding:15px 0; }
  #collection-list :global(img) { width:72px; height:96px; object-fit:cover; border-radius:8px; background:#faf6f8; }
  #collection-list :global(.collection-info) { min-width:0; }
  #collection-list :global(.collection-title) { display:block; font-size:17px; font-weight:650; overflow-wrap:anywhere; }
  #collection-list :global(.collection-original) { display:block; color:#918a97; font-size:12px; margin-top:3px; }
  #collection-list :global(.collection-meta) { display:flex; flex-wrap:wrap; gap:7px; margin-top:9px; color:var(--muted); font-size:12px; }
  #collection-list :global(.collection-meta span) { border-radius:6px; background:#f6f4f8; padding:3px 7px; }
  #collection-list :global(.collection-comment) { display:block; margin-top:8px; color:var(--muted); font-size:12px; line-height:1.5; }
  #collection-list :global(.collection-related) { display:inline-block; margin-top:8px; color:var(--pink); font-size:12px; }
  #collection-list :global(.collection-scores) { display:grid; gap:7px; min-width:105px; text-align:right; }
  #collection-list :global(.collection-scores strong) { display:block; color:var(--pink); font-size:18px; font-variant-numeric:tabular-nums; }
  #collection-list :global(.collection-scores small) { display:block; color:var(--muted); font-size:11px; }
  .pager {margin:16px 0 32px}
  @media(max-width:760px){.status-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:520px){.collection-source{display:none}.status-grid{gap:6px}.status-grid button{padding:10px}#collection-list :global(li){grid-template-columns:56px minmax(0,1fr);gap:11px}#collection-list :global(img){width:56px;height:76px}#collection-list :global(.collection-title){font-size:14px}#collection-list :global(.collection-scores){grid-column:2;display:flex;min-width:0;text-align:left;gap:12px}#collection-list :global(.collection-scores strong){font-size:14px}}
</style>
<script>
  import '../scripts/bangumi.js';
</script>
