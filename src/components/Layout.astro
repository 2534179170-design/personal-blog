---
import Icon from './Icon.astro';
import { href, profile, posts, albums, adminUrl } from '../lib/blog.mjs';
import '../styles/site.css';
const { title, active = '首页', description = profile.signature } = Astro.props;
const nav = [['首页', '', 'home'], ['空间', 'posts/', 'book'], ['相册', 'albums/', 'image'], ['关于我', 'about/', 'user']];
const items = [
  ...posts.map(post => ({ title: post.title, kind: '空间', path: href('posts/' + post.id + '/') })),
  ...albums.map(album => ({ title: album.title, kind: '相册', path: href('albums/' + album.id + '/') }))
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={href('sprout.svg')} />
    <title>{title ? title + ' · ' + profile.siteName : profile.siteName}</title>
  </head>
  <body id="top">
    <header class="top">
      <div class="top-inner">
        <a class="brand" href={href('')}><span class="brand-mark" aria-hidden="true">洺</span><span>{profile.siteName}</span></a>
        <nav aria-label="主导航">
          {nav.map(([label, route, icon]) => <a class:list={['nav-item', { active: active === label }]} aria-current={active === label ? 'page' : undefined} href={href(route)}><Icon name={icon} size={15} />{label}</a>)}
        </nav>
        <div class="header-tools">
          <button class="search-toggle" aria-label="搜索本站" title="搜索本站"><Icon name="search" size={18} /></button>
          <a class="header-avatar" href={href('about/')} aria-label="查看站主资料"><img src={href(profile.avatar || 'art/avatar.webp')} alt="" width="30" height="30" /></a>
        </div>
      </div>
    </header>
    <main class="shell"><slot /></main>
    <footer><span>© {new Date().getFullYear()} {profile.siteName}</span><div><a href="#top">回到顶部 ↑</a><a href={adminUrl}>站主管理</a></div></footer>
    <dialog id="search-dialog">
      <div class="split"><h2>搜索小站</h2><button data-close aria-label="关闭搜索">×</button></div>
      <input type="search" id="site-search" placeholder="搜索空间或相册" aria-label="搜索空间或相册" />
      <ul>{items.map(item => <li data-search={item.title}><a href={item.path}><small>{item.kind}</small> {item.title}</a></li>)}</ul>
      <p id="no-results" hidden>没有找到相关内容。</p>
    </dialog>
    <script>
      const dialog = document.querySelector('#search-dialog') as HTMLDialogElement;
      const field = document.querySelector('#site-search') as HTMLInputElement;
      document.querySelector('.search-toggle')?.addEventListener('click', () => {
        dialog.showModal();
        field.focus();
      });
      dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      field.addEventListener('input', () => {
        let count = 0;
        dialog.querySelectorAll<HTMLElement>('[data-search]').forEach(element => {
          element.hidden = !element.dataset.search?.toLowerCase().includes(field.value.trim().toLowerCase());
          if (!element.hidden) count++;
        });
        (document.querySelector('#no-results') as HTMLElement).hidden = count > 0;
      });
    </script>
  </body>
</html>
