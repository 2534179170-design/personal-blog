---
import { href } from '../lib/blog.mjs';
const { album } = Astro.props;
---
<a class="album-card" href={href('albums/' + album.id + '/')}>
  <div class="album-cover"><img src={href(album.photos[0]?.thumb || 'art/meadow.webp')} alt="" loading="lazy" /></div>
  <strong>{album.title}</strong>
  <span class="album-info">{album.photos.length} 张照片<span>·</span>{album.date.replaceAll('-', '.')}</span>
</a>
