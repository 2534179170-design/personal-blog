---
import Icon from './Icon.astro';
import { albums, href, markdown, profile } from '../lib/blog.mjs';

const album = albums.find(item => item.id === 'field-sketches');
const photos = album?.photos.filter(photo => !photo.spoiler) ?? [];
const opening = photos.find(photo => photo.src === 'art/wa2-provided-duo.png');
const slides = opening ? [opening, ...photos.filter(photo => photo !== opening)] : [...photos];
if (!slides.length) slides.push({ src: profile.cover || 'art/winter-piano.webp', caption: '' });
const hasSuffix = profile.siteName.endsWith('的小站') && profile.siteName.length > 3;
const name = hasSuffix ? profile.siteName.slice(0, -3) : profile.siteName;
---
<section class="winter-cover" aria-labelledby="cover-heading">
  <div class="cover-stage">
    <div class="cover-art">
      {slides.map((photo, index) => <img src={href(photo.src)} alt="" data-slide data-active={String(index === 0)} fetchpriority={index === 0 ? 'high' : 'auto'} loading={index === 0 ? 'eager' : 'lazy'} />)}
    </div>
    <div class="cover-type">
      <h1 id="cover-heading"><span>{name}</span>{hasSuffix && <small>的小站</small>}</h1>
      <div class="cover-bio" set:html={markdown(profile.bio)} />
      {profile.signature && <p>{profile.signature}</p>}
      {profile.now && <p><b>近况</b> {profile.now}</p>}
      <div class="cover-actions">
        <a class="cover-primary" href="#watching">正在追的动画 <span aria-hidden="true">↓</span></a>
        <a href={href('posts/')}>浏览空间 <Icon name="arrow" size={15}/></a>
      </div>
    </div>
    <a class="cover-scroll" href="#watching" aria-label="向下查看正在追的动画"><span aria-hidden="true">⌄</span></a>
  </div>
</section>
<script>
  const cover = document.querySelector('.winter-cover');
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let active = 0;
  let timer: ReturnType<typeof setInterval> | undefined;
  function schedule() {
    clearInterval(timer);
    if (reduced.matches || document.hidden || slides.length < 2 || cover?.matches(':hover, :focus-within')) return;
    timer = setInterval(() => {
      slides[active].dataset.active = 'false';
      active = (active + 1) % slides.length;
      slides[active].dataset.active = 'true';
    }, 9000);
  }
  cover?.addEventListener('mouseenter', schedule);
  cover?.addEventListener('mouseleave', schedule);
  cover?.addEventListener('focusin', schedule);
  cover?.addEventListener('focusout', () => requestAnimationFrame(schedule));
  document.addEventListener('visibilitychange', schedule);
  reduced.addEventListener('change', schedule);
  schedule();
</script>
<style>
  .winter-cover { width:100%; color:#182842; }
  .cover-stage {
    position:relative; isolation:isolate; overflow:hidden;
    min-height:100vh; min-height:100svh;
    display:flex; align-items:flex-end;
    background:#dce5f2;
  }
  .cover-stage::after {
    content:""; position:absolute; inset:0; z-index:0; pointer-events:none;
    background:linear-gradient(180deg,transparent 36%,#0e183633 70%,#0a173466 100%);
  }
  .cover-art, .cover-art img { position:absolute; inset:0; width:100%; height:100%; }
  .cover-art img {
    object-fit:cover; object-position:center 37%;
    opacity:0; transition:opacity 1.2s ease;
  }
  .cover-art img[data-active="true"] { opacity:1; }
  .cover-type {
    position:relative; z-index:1; width:min(570px,calc(100% - 48px));
    margin:0 0 clamp(70px,12vh,128px) clamp(24px,7vw,120px);
    padding:clamp(23px,3.1vw,42px);
    border:1px solid #ffffff9c; border-radius:24px;
    background:#f7f9f8c7;
    -webkit-backdrop-filter:blur(22px) saturate(1.25);
    backdrop-filter:blur(22px) saturate(1.25);
    box-shadow:0 20px 70px #17264338,inset 0 1px #fff;
  }
  .cover-type h1 {
    margin:0; display:flex; align-items:baseline; flex-wrap:wrap; gap:0 .35em;
    font-family:"Songti SC","STSong","SimSun","Noto Serif CJK SC",serif;
    font-weight:700; letter-spacing:-.055em; line-height:1.16;
  }
  .cover-type h1 span { font-size:clamp(44px,5vw,74px); }
  .cover-type h1 small { font-size:clamp(25px,2.8vw,40px); font-weight:500; white-space:nowrap; }
  .cover-bio { margin-top:14px; }
  .cover-type p, .cover-bio :global(p) { margin:5px 0; font-size:clamp(13px,1.05vw,16px); line-height:1.7; }
  .cover-actions { display:flex; align-items:center; gap:24px; margin-top:22px; }
  .cover-actions a {
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    min-height:44px; color:#172c48; font-size:14px; font-weight:650;
  }
  .cover-actions .cover-primary { border-radius:30px; padding:0 19px; color:white; background:#172c48; }
  .cover-primary span { color:#c5e9ff; font-size:19px; }
  .cover-scroll {
    position:absolute; z-index:1; left:50%; bottom:clamp(15px,3vh,35px);
    display:grid; place-items:center; width:46px; height:46px; border-radius:50%;
    color:#fff; background:#1b2d48a3; transform:translateX(-50%);
    -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
  }
  .cover-scroll span { font:36px/1 Arial,sans-serif; margin-top:-10px; }
  .winter-cover a:focus-visible { outline:3px solid #b73560; outline-offset:3px; }
  @media(hover:hover) {
    .cover-actions a:hover { color:#a12d50; }
    .cover-actions .cover-primary:hover, .cover-scroll:hover { background:#87324e; color:#fff; }
  }
  @media(max-width:720px) {
    .cover-art img { object-position:right center; }
    .cover-type {
      width:calc(100% - 32px); margin:0 16px 82px;
      padding:20px; border-radius:18px;
    }
    .cover-type h1 span { font-size:clamp(37px,10vw,54px); }
    .cover-type h1 small { font-size:clamp(23px,6vw,32px); }
    .cover-bio { margin-top:8px; }
    .cover-actions { gap:16px; margin-top:13px; }
  }
  @media(max-height:620px) {
    .cover-type { margin-bottom:66px; }
  }
  @media(prefers-reduced-motion:no-preference) {
    .cover-type { animation:cover-enter .75s .18s cubic-bezier(.2,.72,.23,1) both; }
    .cover-scroll { animation:scroll-hint 2.3s ease-in-out infinite; }
    @keyframes cover-enter { from { opacity:0; transform:translateY(18px); } }
    @keyframes scroll-hint { 50% { translate:0 6px; } }
  }
</style>
