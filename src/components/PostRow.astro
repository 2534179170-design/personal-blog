---
import { href, profile, publicSummary } from '../lib/blog.mjs';
const { post, showAvatar = true, featured = false } = Astro.props;
---
<article class:list={['post-row', { 'no-avatar': !showAvatar, featured }]} data-tags={JSON.stringify(post.tags)}>
  {showAvatar && <a class="post-author" href={href('about/')} aria-label={profile.nickname + '的个人资料'}>
    <img src={href(profile.avatar || 'art/avatar-mingxue.webp')} alt="" loading="lazy" />
  </a>}
  <div class="post-copy">
    <h3><a href={href('posts/' + post.id + '/')}>{post.title}</a></h3>
    <p>{publicSummary(post.summary)}</p>
    <div class="post-meta">
      <a class="author-name" href={href('about/')}>{profile.nickname}</a>
      {post.tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
  {post.cover && <a href={href('posts/' + post.id + '/')} class="post-image" tabindex="-1" aria-hidden="true"><img src={href(post.cover)} alt="" loading="lazy" /></a>}
  <time datetime={post.date}>{post.date.replaceAll('-', '.')}</time>
</article>
